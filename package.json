{
  "name": "silly-simple",
  "version": "0.1.0",
  "private": true,
  "description": "A simple desktop app for local AI roleplay chat.",
  "author": "VivienG",
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "mood:lab": "vitest run --config lab/vitest.config.ts mood.lab",
    "mood:replay": "vitest run --config lab/vitest.config.ts mood/replay.lab",
    "scene:lab": "vitest run --config lab/vitest.config.ts scene.lab",
    "scene:replay": "vitest run --config lab/vitest.config.ts scene/replay.lab",
    "dist": "node scripts/dist.mjs",
    "dist:all": "node scripts/dist.mjs --all"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@lucide/vue": "^1.52.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vueuse/core": "^15.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "motion-v": "^2.5.2",
    "pinia": "^4.0.3",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.12"
  }
}
